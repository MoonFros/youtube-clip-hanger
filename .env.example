# Optional environment for the api container (all keys are optional —
# FairClip falls back to on-device processing without them).
# docker compose reads this file automatically; `./run.sh` users can export
# the same variables in their shell.

# ---- cloud AI (optional) ----------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ELEVENLABS_API_KEY=
FAIRCLIP_WHISPER_MODEL=base
# set to 0 to never auto-download the local Whisper model
FAIRCLIP_WHISPER_DOWNLOAD=1

# ---- YouTube / yt-dlp -------------------------------------------------------
# Cap the source resolution. 720p is plenty for a 9:16 clip and cuts both the
# download and every analysis stage in half compared to 1080p.
FAIRCLIP_YTDLP_MAX_HEIGHT=720
# "Sign in to confirm you're not a bot"? Reuse your browser cookies:
# FAIRCLIP_COOKIES_FROM_BROWSER=chrome
# FAIRCLIP_COOKIES_FILE=/path/to/cookies.txt
# Only download the first N minutes of very long videos (0 = all):
FAIRCLIP_MAX_SOURCE_MINUTES=0
# Escape hatch for any yt-dlp option, e.g. FAIRCLIP_YTDLP_EXTRA_ARGS=proxy=http://127.0.0.1:8080
FAIRCLIP_YTDLP_EXTRA_ARGS=

# ---- performance ------------------------------------------------------------
# Path to ffmpeg if it is installed but not on PATH (5-20x faster stages when set).
# FAIRCLIP_FFMPEG=/usr/bin/ffmpeg
# Videos longer than this use the fast 16 kHz stem analysis (default 900 = 15 min).
FAIRCLIP_STEMS_LONG_AFTER_S=900
# Stem analysis block size in seconds — smaller = less RAM, a bit slower.
FAIRCLIP_STEMS_BLOCK_S=20

# ---- storage ----------------------------------------------------------------
FAIRCLIP_DATA=/app/data
